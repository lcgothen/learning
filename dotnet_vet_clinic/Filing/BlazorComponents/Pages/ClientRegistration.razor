@page "/client-registration"
@using Filing.Logic
@using Filing.Models
@rendermode InteractiveServer
@inject IImplementation ImplementationInstance

<PageTitle>Client Registration</PageTitle>

<h1>Client Registration</h1>

@if (!success) {
    <form method="post" @onsubmit="@Submit" @formname="client-registration-form">
        <AntiforgeryToken />
        <div>Full Name: </div>
        <div>
            <label>
                <InputText @bind-Value="client.Name" />
            </label>
        </div>
        <div>Address: </div>
        <div >
            <label>
                <InputText @bind-Value="client.Address" />
            </label>
        </div>
        <div>Phone Number:  </div>
        <div>
            <label>
                <InputText @bind-Value="client.PhoneNumber" />
            </label>
        </div>
        @if(!String.IsNullOrEmpty(message)) {
            <div class="error-message" style="margin-top:10px;">@message</div>
        }
        <div style="margin-top:10px;">
            <button class="btn btn-primary" type="submit">Submit</button>
            <button class="btn btn-secondary" type="button" @onclick="@Reset">Clear</button>
        </div>
    </form>
    
}
else {
    <div class="success-message"> Successfully registered new client! </div>
    <div class="receipt">
        <div>Full Name: @client.Name</div>
        <div>Address: @client.Address</div>
        <div>Phone Number: @client.PhoneNumber</div>
    </div>
    <div style="margin-top:10px;">
        <button class="btn btn-primary" @onclick="@Reset">New registration</button>
    </div>
}

@code {
    public Client client = new Client("", "", "");
    public string message = "";
    public bool success = false;

    public void Submit() {
        var result = ImplementationInstance.AddClient(client);

        switch(result) {
            case ReturnCodes.Success: {
                success = true;
            } break;
            case ReturnCodes.Conflict: {
                message = "A client with this phone number is already registered.";
            } break;
            case ReturnCodes.NotFound:
            case ReturnCodes.UnknownError:
            default: {
                message = "Unknown error ocurred.";
            } break;
        }
    }

    public void Reset() {
        message = "";
        success = false;
        client = new Client("", "", "");
    }
}
